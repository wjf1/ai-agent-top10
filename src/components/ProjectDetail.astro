---
/** 项目详情页（zh / en 共用），含 8 维评分、维度口径说明与 star 趋势图（P1-F2/P1-U3） */
import Base from "../layouts/Base.astro";
import EntryCard from "./EntryCard.astro";
import Radar from "./Radar.astro";
import ScoreTrend from "./ScoreTrend.astro";
import TrendChart from "./TrendChart.astro";
import { categoryLabel } from "../lib/categorize.mjs";
import { caliberTag, detailLead, forkAnomaly, gainSourceTag, highlightsTitle, interpretationTag, momentReasons, scoreFactors } from "../lib/display.ts";
import { scoringVersion } from "../lib/config.mjs";
import { dimensionLabels, strings, type Lang } from "../lib/data.ts";
import { archivePath, categoryPath, comparePath, dayPath } from "../lib/routes.ts";

interface Props {
  entry: any;
  date: string;
  lang?: Lang;
  series: { date: string; stars?: number | null; forks?: number | null }[];
  langHref: string;
  /** 增量与增速所覆盖的天数，来自当期日榜的 windowDays */
  windowDays?: number;
  /** 连续在榜期数（含本期），0 表示未知 */
  streak?: number;
  /** 该项目的最早出现日期（索引里最早出现该 slug 的日期） */
  firstDate?: string;
  /** 相关项目推荐（同类项目 + 同期热门），由页面构建期算好 */
  related?: any[];
  /** 社交分享图路径 */
  ogImage?: string;
  /** 维度定义（key + 短名），评分趋势图用 */
  trendDims?: { key: string; label: string }[];
  /** 各维度评分历史序列；为 null 表示不满足展示门槛（连续在榜不足 3 期） */
  scoreTrend?: Record<string, { date: string; value: number }[]> | null;
}

const { entry, date, lang = "zh", series = [], langHref, windowDays = 7, streak = 0, firstDate = "", related = [], ogImage, trendDims = [], scoreTrend = null } = Astro.props;
const t = strings(lang);
const B = import.meta.env.BASE_URL.replace(/\/$/, "");
const fmt = (n: number) => Number(n ?? 0).toLocaleString("en-US");

const allDims = dimensionLabels(lang);
const dims = allDims.filter((d) => typeof entry.scores?.[d.key] === "number");
const listHref = dayPath(B, lang, date);
const archiveHref = archivePath(B, lang);

const stats = [
  { label: t.stars, value: fmt(entry.stars) },
  { label: t.language, value: entry.language || "—" },
  { label: t.statWeekGain, value: `+${fmt(entry.weeklyGain)}` },
  { label: t.forks, value: fmt(entry.forks) },
];
const minorStats = [
  `${t.rank} #${entry.rank}`,
  `${t.growthRate} +${entry.growthRate}%`,
  ...(typeof entry.forksGain === "number" ? [`${t.forksGain} +${fmt(entry.forksGain)}`] : []),
  ...(typeof entry.contributors === "number" ? [`${lang === "zh" ? "贡献者" : "Contributors"} ${fmt(entry.contributors)}`] : []),
  ...(typeof entry.prActivity === "number" ? [`PR / 30d ${fmt(entry.prActivity)}`] : []),
  ...(typeof entry.issueActivity === "number" ? [`Issue / 30d ${fmt(entry.issueActivity)}`] : []),
];

const change = typeof entry.rankChange === "number" ? entry.rankChange : null;
const srcTag = gainSourceTag(entry, t);
const caliber = caliberTag(entry, scoringVersion(), t);

// 头图导语：用「卡片一行版」这个字段，它本就是为一句话定位设计的。
// 早先取介绍首句，遇到单句式介绍时头图和「它能做什么？」会一字不差地重复同一句。
const lead = detailLead(entry, lang);
const interpTag = interpretationTag(entry, t);
const factors = scoreFactors(entry.scores, dims);
const scoreSummary = t.scoreSummary(entry.scores.overall, factors.low, factors.high);
const moments = momentReasons({ ...entry, firstSeen: firstDate || entry.firstSeen }, { streak, date, t });
const anomaly = forkAnomaly(entry, t);
---

<Base
  lang={lang}
  langHref={langHref}
  title={entry.full_name}
  desc={String(entry.intro?.[lang] ?? entry.why?.[lang] ?? "").slice(0, 150)}
  active="day"
  date={date}
  {ogImage}
>
  <section class="detail-head">
    <div class="crumb">
      <a href={listHref}>{date} {t.periodDaily}</a> /
      <a href={archiveHref}>{t.archive}</a> /
      {entry.full_name}
    </div>
    <h1>{entry.full_name}</h1>
    {lead && (
      <p class="sub desc">{lead}</p>
    )}
    <div class="tag-row">
      {entry.category && <a class="cat-chip" href={categoryPath(B, lang, entry.category)}>{categoryLabel(entry.category, lang)}</a>}
      {(entry.topics ?? []).slice(0, 6).map((topic: string) => (
        <span class="topic-chip">#{topic}</span>
      ))}
    </div>
    <div class="stat-row">
      {stats.map((p) => (
        <div class="stat-card"><span>{p.label}</span><b>{p.value}</b></div>
      ))}
    </div>
    <div class="stat-minor">{minorStats.join(" · ")}</div>
    <div class="meta-row">
      <a class="btn" href={entry.url} target="_blank" rel="noopener noreferrer">GitHub →</a>
      {entry.homepage && (
        <a class="btn ghost" href={entry.homepage} target="_blank" rel="noopener noreferrer">{t.homepage} →</a>
      )}
      <a class="btn ghost" href={`${comparePath(B, lang)}#${entry.full_name}`}>{t.compare}</a>
      {change !== null && (
        <span class:list={["change-chip", change > 0 ? "up" : change < 0 ? "down" : "same"]}>
          {change > 0 ? `${t.rankUp} ${change}` : change < 0 ? `${t.rankDown} ${Math.abs(change)}` : t.rankSame}
        </span>
      )}
      {(firstDate || entry.firstSeen) && (
        <span class="meta-line">{t.createdNote}：{firstDate || entry.firstSeen}</span>
      )}
    </div>
  </section>

  <div class="detail-grid">
    <div class="panel">
      <div class="overall-big"><div class="n">{entry.scores.overall}</div><div class="l">{t.overall} / 100</div></div>
      <div class="radar-holder">
        <Radar scores={entry.scores} dims={dims} size={262} pad={62} />
      </div>
      <ul class="dim-list">
        {dims.map((d) => (
          <li class="dim-item">
            <div class="dim-line">
              <span class="dim-name">{d.label}</span>
              <div class="dim-bar"><div class="dim-fill" style={`width:${entry.scores[d.key]}%`} /></div>
              <b>{entry.scores[d.key]}</b>
            </div>
            <p class="dim-desc">{d.desc} · {t.weight} {(d.weight * 100).toFixed(0)}%</p>
          </li>
        ))}
      </ul>
      {scoreSummary && <p class="score-summary">{scoreSummary}</p>}
      <p class="hint">{srcTag.note}</p>
      {caliber && <p class="hint" title={caliber.note}>{t.scoreCaliber}：{caliber.label}</p>}
      <p class="hint">{t.growthRateNote(windowDays)}</p>
    </div>

    <div class="detail-col">
      <div class="panel">
        <h2>
          {t.intro}
          {interpTag && (
            <span class="src-tag" title={interpTag.note}>{interpTag.label}</span>
          )}
        </h2>
        <p class="prose">{entry.intro?.[lang] ?? entry.why[lang]}</p>
      </div>

      <div class="panel">
        <h2>{t.momentTitle}</h2>
        <ul class="moment-list">
          {moments.map((r: string) => <li>{r}</li>)}
        </ul>
        {anomaly && <p class="warn-note">{anomaly.text}</p>}
      </div>

      {entry.highlights?.length > 0 && (
        <div class="panel">
          <h2>{highlightsTitle(entry, t)}</h2>
          <ul>{entry.highlights.map((h: any) => <li class="good">{h[lang]}</li>)}</ul>
        </div>
      )}
      {entry.fitFor?.length > 0 && (
        <div class="panel">
          <h2>{t.fitFor}</h2>
          <p class="prose">{entry.fitFor.map((f: any) => f[lang]).join(lang === "zh" ? "；" : "; ")}</p>
        </div>
      )}
      {entry.cons?.length > 0 && (
        <div class="panel">
          <h2>{t.cons}</h2>
          <ul>{entry.cons.map((c: any) => <li class="bad">{c[lang]}</li>)}</ul>
        </div>
      )}

      <div class="panel">
        <h2>{t.trend}</h2>
        <TrendChart points={series} metric="stars" {lang} emptyText={t.trendEmpty} />
      </div>

      <ScoreTrend series={scoreTrend ?? {}} dims={dims} {lang} emptyText={t.scoreTrendEmpty} />

      {entry.quickstart && (
        <div class="panel">
          <h2>{t.quickstart}</h2>
          <pre class="code"><code>{entry.quickstart}</code></pre>
        </div>
      )}
    </div>
  </div>

  {related.length > 0 && (
    <section class="related">
      <h2>{t.relatedTitle}</h2>
      {[
        { kind: "similar", label: t.relatedSimilar, note: t.relatedSimilarNote },
        { kind: "hot", label: t.relatedHot, note: t.relatedHotNote },
      ].map(({ kind, label, note }) => {
        const items = related.filter((r: any) => r.kind === kind);
        if (!items.length) return null;
        return (
          <div class="related-group">
            <p class="related-label" title={note}>{label}</p>
            <div class="related-list">
              {items.map((r: any) => (
                <EntryCard entry={r.entry} date={r.lastDate} {lang} compact windowDays={7} />
              ))}
            </div>
          </div>
        );
      })}
    </section>
  )}
</Base>

<style>
  .detail-head h1 { margin: 6px 0; font-size: clamp(22px, 3.4vw, 32px); word-break: normal; overflow-wrap: anywhere; }
  .detail-head .crumb { font-size: 13px; color: var(--muted); }
  .detail-head .crumb a:hover { color: var(--accent); }
  .detail-head .desc { color: var(--muted); margin: 0; max-width: 760px; }
  .tag-row { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 12px; }
  .cat-chip {
    font-size: 12px; padding: 2px 11px; border-radius: 999px;
    border: 1px solid var(--accent); color: var(--accent); background: var(--accent-soft);
    font-weight: 600;
  }
  .topic-chip { font-size: 12px; padding: 2px 10px; border-radius: 999px; background: var(--card-2); color: var(--muted); border: 1px solid var(--line); }
  /* 相关项目：与首页一致的紧凑卡片，纵向堆叠 */
  .related { margin-top: 34px; }
  .related h2 { font-size: 17px; margin: 0 0 12px; }
  .related-group + .related-group { margin-top: 18px; }
  .related-label { font-size: 13px; font-weight: 600; color: var(--muted); margin: 0 0 8px; }
  .related-list { display: flex; flex-direction: column; gap: 10px; }
  .panel h2 .src-tag {
    margin-left: 8px; font-size: 12px; font-weight: 600; vertical-align: 2px;
    padding: 1px 8px; border-radius: 999px; border: 1px dashed var(--line);
    background: var(--card-2); color: var(--muted); cursor: help;
  }
  .meta-pill b { font-size: 14.5px; }
  .meta-pill span { color: var(--muted); font-size: 12px; display: block; }
  .change-chip { align-self: center; font-size: 12px; font-weight: 700; padding: 3px 11px; border-radius: 999px; }
  .change-chip.up { color: var(--good-ink); background: var(--good-soft); }
  .change-chip.down { color: var(--warn-ink); background: var(--warn-soft); }
  .change-chip.same { color: var(--muted); background: var(--card-2); }
  .meta-line { align-self: center; color: var(--muted); font-size: 12px; }
  .radar-holder { display: flex; justify-content: center; margin-bottom: 8px; overflow: visible; }
  .dim-name { border-bottom: 1px dotted var(--line); cursor: help; }
  .hint { margin: 12px 0 0; color: var(--muted); font-size: 12px; }
  .moment-list { margin: 0; padding-left: 20px; font-size: 13px; line-height: 1.75; }
  .warn-note {
    margin: 10px 0 0; padding: 8px 11px; font-size: 12.5px; line-height: 1.6;
    color: var(--warn-ink); background: var(--warn-soft); border-radius: 8px;
  }
  .detail-col { display: grid; gap: 18px; align-content: start; }
</style>
