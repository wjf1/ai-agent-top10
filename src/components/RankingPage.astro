---
/** 榜单主体（日榜 / 周榜 / 月榜、zh / en 共用） */
import Base from "../layouts/Base.astro";
import EntryCard from "./EntryCard.astro";
import Icon from "./Icon.astro";
import PeriodSwitch from "./PeriodSwitch.astro";
import ProjectTable from "./ProjectTable.astro";
import { categories } from "../lib/categorize.mjs";
import { strings, type Lang } from "../lib/data.ts";
import { categoryPath, dayPath, homePath, projectPath } from "../lib/routes.ts";

interface Props {
  lang?: Lang;
  period: "daily" | "weekly" | "monthly";
  date: string;
  entries: any[];
  /** 实际覆盖天数（周/月榜可能小于请求窗口） */
  coverageDays?: number;
  requestedDays?: number;
  baselineDate?: string | null;
  poolSize?: number;
  archiveHref: string;
  prevHref?: string | null;
  nextHref?: string | null;
  langHref: string;
  /** 周期榜不可用时的说明（例如历史快照还凑不满一个窗口） */
  unavailableReason?: string | null;
  /** 窗口内指标快照不完整时提示维度被剔除 */
  partialMetrics?: boolean;
  /** 周期窗口内聚合了多个评分引擎版本时给出提示 */
  scoringMixed?: boolean;
  scoringVersions?: string[];
}

const {
  lang = "zh",
  period,
  date,
  entries,
  coverageDays,
  requestedDays,
  baselineDate = null,
  poolSize,
  archiveHref,
  prevHref = null,
  nextHref = null,
  langHref,
  unavailableReason = null,
  partialMetrics = false,
  scoringMixed = false,
  scoringVersions = [],
} = Astro.props;

const t = strings(lang);
const B = import.meta.env.BASE_URL.replace(/\/$/, "");
const fmt = (n: number) => Number(n ?? 0).toLocaleString("en-US");
const totalGain = entries.reduce((s, e) => s + (e.weeklyGain ?? 0), 0);
const avgGain = entries.length ? Math.round(totalGain / entries.length) : 0;
const cats = categories();
const catKeys = [...new Set(entries.map((e) => e.category ?? "other"))];
const visibleCats = cats.filter((c) => catKeys.includes(c.key as string));

const periodLabel = period === "daily" ? t.periodDaily : period === "weekly" ? t.periodWeekly : t.periodMonthly;
const title = period === "daily" ? t.todayTop : `${t.todayTop} · ${periodLabel}`;
const windowDays = requestedDays ?? (period === "monthly" ? 30 : period === "weekly" ? 7 : 1);
/** 增量数字实际覆盖的天数：日榜固定 7 天窗口，周期榜按真实覆盖天数 */
const gainDays = period === "daily" ? 7 : coverageDays || windowDays;
const effectiveDays = coverageDays ?? windowDays;
const rankDesc = period === "daily" ? t.rankBy : t.rankByWindow(effectiveDays);
const showCoverage = !!coverageDays && !!requestedDays && coverageDays < requestedDays;

const activeNav = period === "daily" ? "home" : period === "weekly" ? "week" : "month";
---

<Base lang={lang} langHref={langHref} title={`${date} ${periodLabel}`} desc={t.heroSub} active={activeNav} date={period === "daily" ? date : null}>
  <section class="hero">
    <span class="date-chip"><Icon name="calendar" size={13} /> {date} · {periodLabel} · {rankDesc}</span>
    <h1>{title}</h1>
    <p class="sub">{t.heroSub}</p>
    <div class="stats">
      <div class="stat"><b>{entries.length}</b><span>{t.entries}</span></div>
      <div class="stat"><b>+{fmt(totalGain)}</b><span>{t.totalGain}</span></div>
      <div class="stat">
        <b>+{fmt(avgGain)}</b>
        <span>{lang === "zh" ? "平均单项目增量" : "Avg Gain / Project"}</span>
      </div>
      {poolSize ? (
        <div class="stat"><b>{poolSize}</b><span>{t.candidates}</span></div>
      ) : null}
    </div>
  </section>

  <PeriodSwitch
    {lang}
    current={period}
    date={date}
    dailyHref={homePath(B, lang)}
    archiveHref={archiveHref}
    {prevHref}
    {nextHref}
  />

  {showCoverage && (
    <p class="notice" role="note"><Icon name="alert" size={14} /> {t.coverageNote(coverageDays!, requestedDays!)}</p>
  )}
  {partialMetrics && entries.length > 0 && (
    <p class="notice" role="note"><Icon name="alert" size={14} /> {t.partialMetricsNote}</p>
  )}
  {baselineDate && period !== "daily" && <p class="meta-line">{t.baselineNote(baselineDate)}</p>}

  {visibleCats.length > 1 && (
    <nav class="cat-tabs" aria-label={t.categories}>
      <span class="cat-label">{t.categories}：</span>
      {visibleCats.map((c) => (
        <a class="cat-chip" href={categoryPath(B, lang, c.key as string)}>{lang === "zh" ? c.zh : c.en}</a>
      ))}
    </nav>
  )}

  {entries.length === 0 ? (
    <section class="empty-board">
      <h2>{period === "monthly" ? t.periodMonthly : t.periodWeekly} · {lang === "zh" ? "暂不可用" : "not available yet"}</h2>
      <p>
        {lang === "zh"
          ? "该周期需要至少一个完整窗口的历史快照才能计算，目前快照序列还不够长。每日抓取的快照会在积累到 7 / 30 天后自动补齐本页。"
          : "This period needs a full window of historical snapshots, and the snapshot series is still too short. It fills in automatically once enough daily snapshots accumulate."}
      </p>
      {unavailableReason && <p class="reason"><code>{unavailableReason}</code></p>}
      <p><a class="btn ghost" href={homePath(B, lang)}>{t.backToList}</a></p>
    </section>
  ) : (
    <>
      <div class="list-toolbar">
        <p class="rank-note">
          <Icon name="info" size={14} />
          <span>
            {lang === "zh"
              ? `排名依据：近 ${effectiveDays} 天 Star 增量；综合分为独立的 8 维评估，与排名无关。`
              : `Ranked by: Star gain in last ${effectiveDays}d; Overall score is an independent rating.`}
          </span>
          {entries[0] && (
            <a href={projectPath(B, lang, date, entries[0].slug)}>
              {lang === "zh" ? "评分方法与维度 →" : "Scoring criteria →"}
            </a>
          )}
        </p>
        <div class="view-toggle" role="group" aria-label={lang === "zh" ? "视图切换" : "View switch"}>
          <button type="button" class="view-btn active" data-view="card" aria-pressed="true">
            <Icon name="card" size={14} />
            <span>{lang === "zh" ? "卡片" : "Cards"}</span>
          </button>
          <button type="button" class="view-btn" data-view="table" aria-pressed="false">
            <Icon name="table" size={14} />
            <span>{lang === "zh" ? "表格" : "Table"}</span>
          </button>
        </div>
      </div>

      {scoringMixed && (
        <p class="caliber-note" role="note">
          <Icon name="info" size={14} />
          <span>{t.scoringMixedNote(scoringVersions.join(" · ") || "—")}</span>
        </p>
      )}

      <section class="entry-list" id="card-view-container">
        {entries.map((e) => (
          <EntryCard entry={e} date={date} {lang} windowDays={gainDays} />
        ))}
      </section>

      <div class="table-view-wrap hidden" id="table-view-container">
        <ProjectTable projects={entries} {lang} windowDays={effectiveDays} {date} />
      </div>
    </>
  )}

  <details class="data-note">
    <summary>{t.dataQuality}</summary>
    <p>{t.dataQualityBody}</p>
  </details>

  {period !== "daily" && (
    <p class="meta-line">
      <a href={dayPath(B, lang, date)}>{lang === "zh" ? "查看当天的日榜详情" : "Open the daily board for this date"} →</a>
    </p>
  )}
</Base>

<script>
  (function () {
    const cardBtn = document.querySelector('[data-view="card"]') as HTMLButtonElement | null;
    const tableBtn = document.querySelector('[data-view="table"]') as HTMLButtonElement | null;
    const cardView = document.getElementById("card-view-container");
    const tableView = document.getElementById("table-view-container");

    if (!cardBtn || !tableBtn || !cardView || !tableView) return;

    function applyView(mode: "card" | "table") {
      if (mode === "table") {
        cardView?.classList.add("hidden");
        tableView?.classList.remove("hidden");
        cardBtn?.classList.remove("active");
        cardBtn?.setAttribute("aria-pressed", "false");
        tableBtn?.classList.add("active");
        tableBtn?.setAttribute("aria-pressed", "true");
      } else {
        tableView?.classList.add("hidden");
        cardView?.classList.remove("hidden");
        tableBtn?.classList.remove("active");
        tableBtn?.setAttribute("aria-pressed", "false");
        cardBtn?.classList.add("active");
        cardBtn?.setAttribute("aria-pressed", "true");
      }
      try {
        localStorage.setItem("agent-top10-view-mode", mode);
      } catch (e) {
        // Ignore localStorage error
      }
    }

    try {
      const saved = localStorage.getItem("agent-top10-view-mode");
      if (saved === "table") {
        applyView("table");
      }
    } catch (e) {}

    cardBtn.addEventListener("click", () => applyView("card"));
    tableBtn.addEventListener("click", () => applyView("table"));
  })();
</script>

<style>
  .hidden { display: none !important; }
  .table-view-wrap { margin-top: 16px; }
  .notice {
    margin: 16px 0 0;
    padding: 11px 14px;
    border-radius: 10px;
    background: var(--warn-soft);
    color: var(--warn-ink);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .meta-line { color: var(--muted); font-size: 12.5px; margin: 10px 0 0; }
  .meta-line a:hover { color: var(--accent); }
  .cat-tabs { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 18px 0 0; }
  .cat-label { font-size: 12.5px; color: var(--muted); }
  .cat-chip {
    font-size: 12.5px;
    padding: 3px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
  }
  .cat-chip:hover { border-color: var(--accent); color: var(--accent); }
  .empty-board {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px 24px;
    margin: 22px 0 44px;
  }
  .empty-board h2 { margin: 0 0 10px; font-size: 17px; }
  .empty-board p { margin: 0 0 12px; color: var(--muted); font-size: 13.5px; max-width: 640px; }
  .empty-board .reason code { font-size: 12px; color: var(--muted); }
  .data-note {
    margin: 0 0 44px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--muted);
    font-size: 13px;
  }
  .data-note summary { cursor: pointer; color: var(--ink); font-weight: 600; }
  .data-note p { margin: 10px 0 0; }
</style>
