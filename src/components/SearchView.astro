---
/**
 * 检索视图（T3.1）—— 由 search.astro 与 search/[...view].astro 共用。
 *
 * 关键设计：**排序与快捷筛选做成独立静态路由，而不是 query 参数。**
 * 纯静态站点在构建期读不到 query，若把排序挂在 `?sort=` 上，无 JS 时点任何排序都
 * 只会重新加载同一份 HTML —— 排序等于失效。改成 `/search/s/<key>/` 这类真实路径后，
 * 每个排序/预设都有自己的静态页，整页跳转即可生效，无 JS 完全可用且链接可分享。
 *
 * 关键字 / 分类 / 语言仍是客户端过滤（表格在构建期已完整渲染，无 JS 时全量可见）。
 */
import Icon from "./Icon.astro";
import ProjectTable from "./ProjectTable.astro";
import { categories } from "../lib/categorize.mjs";
import { strings, type Lang } from "../lib/data.ts";
import { PRESETS, SORTS } from "../lib/search-view.ts";

interface Props {
  projects: any[];
  lang: Lang;
  /** 当前排序 key（默认 gain） */
  activeSort?: string;
  /** 当前快捷筛选 key（null = 未启用） */
  activePreset?: string | null;
  window: number;
}

const { projects, lang, activeSort = "gain", activePreset = null, window } = Astro.props;
const t = strings(lang);
const B = import.meta.env.BASE_URL.replace(/\/$/, "");

const base = `${B}${lang === "en" ? "/en" : ""}/search`;
/** 保持「排序 + 预设」组合可叠加：切换其一时保留另一个 */
const hrefFor = ({ sort = activeSort, preset = activePreset }: { sort?: string; preset?: string | null } = {}) => {
  const parts: string[] = [];
  if (preset) parts.push(`p/${preset}`);
  // 默认排序（gain）不写进路径，避免出现两条指向同一内容的 URL
  if (sort && sort !== "gain") parts.push(`s/${sort}`);
  return parts.length ? `${base}/${parts.join("/")}/` : `${base}/`;
};

const langs = [...new Set(projects.map((p) => p.entry.language))].sort();
const cats = categories().filter((c) => projects.some((p) => (p.entry.category ?? "other") === c.key));
const activePresetSpec = PRESETS.find((p) => p.key === activePreset) ?? null;
---

<div class="filters" data-search-root>
  <input
    type="search"
    class="search-input"
    data-search-input
    placeholder={t.searchPlaceholder}
    aria-label={t.search}
    autocomplete="off"
  />

  <div class="ctl-row">
    <span class="ctl-label">{lang === "zh" ? "排序" : "Sort"}</span>
    <div class="chips-row" role="group" aria-label={lang === "zh" ? "排序方式" : "Sort by"}>
      {SORTS.map((s) => (
        <a
          class:list={["fchip", activeSort === s.key && "active"]}
          href={hrefFor({ sort: s.key })}
          aria-current={activeSort === s.key ? "true" : undefined}
        >{lang === "zh" ? s.zh : s.en}</a>
      ))}
    </div>
  </div>

  <div class="ctl-row">
    <span class="ctl-label">{lang === "zh" ? "快捷筛选" : "Presets"}</span>
    <div class="chips-row" role="group" aria-label={lang === "zh" ? "快捷筛选" : "Quick presets"}>
      <a class:list={["fchip", !activePreset && "active"]} href={hrefFor({ preset: null })}>
        {t.allCategories}
      </a>
      {PRESETS.map((p) => (
        <a
          class:list={["fchip", activePreset === p.key && "active"]}
          href={hrefFor({ preset: p.key })}
          title={lang === "zh" ? p.noteZh : p.noteEn}
          aria-current={activePreset === p.key ? "true" : undefined}
        >{lang === "zh" ? p.zh : p.en}</a>
      ))}
    </div>
  </div>

  {activePresetSpec && (
    <p class="preset-note">
      {lang === "zh" ? activePresetSpec.noteZh : activePresetSpec.noteEn}
    </p>
  )}

  <div class="ctl-row">
    <span class="ctl-label">{lang === "zh" ? "分类" : "Category"}</span>
    <div class="chips-row" role="group" aria-label={t.categories}>
      <button type="button" class="fchip active" data-filter-category="all">{t.allCategories}</button>
      {cats.map((c) => (
        <button type="button" class="fchip" data-filter-category={c.key}>{lang === "zh" ? c.zh : c.en}</button>
      ))}
    </div>
  </div>

  <div class="ctl-row">
    <span class="ctl-label">{lang === "zh" ? "语言" : "Language"}</span>
    <div class="chips-row" role="group" aria-label={t.language}>
      <button type="button" class="fchip active" data-filter-language="all">{t.allCategories}</button>
      {langs.map((l) => (
        <button type="button" class="fchip" data-filter-language={l}>{l}</button>
      ))}
    </div>
  </div>

  <p class="count" data-search-count></p>
</div>

{projects.length === 0 ? (
  <div class="search-empty" role="status">
    <div class="empty-icon"><Icon name="search" size={28} /></div>
    <h3>{lang === "zh" ? "该筛选条件下没有项目" : "No projects under this filter"}</h3>
    <p class="empty-tip">
      {lang === "zh" ? "换一个排序或快捷筛选条件试试。" : "Try another sort or preset."}
    </p>
    <a class="btn ghost reset-btn" href={base + "/"}>{lang === "zh" ? "回到全部项目" : "Back to all projects"}</a>
  </div>
) : (
  <ProjectTable projects={projects} {lang} windowDays={window} />
)}

<div id="search-empty" class="search-empty hidden" role="status">
  <div class="empty-icon"><Icon name="search" size={28} /></div>
  <h3>{lang === "zh" ? "未找到匹配的项目" : "No matching projects found"}</h3>
  <p class="empty-tip">
    {lang === "zh"
      ? "尝试调整搜索关键词，或重置分类与语言筛选条件。"
      : "Try adjusting your search keywords, or reset category and language filters."}
  </p>
  <button type="button" class="btn ghost reset-btn" id="reset-filters-btn">
    {lang === "zh" ? "清除所有筛选条件" : "Clear all filters"}
  </button>
</div>

<script>
  // 过滤的是构建期已经渲染好的行，不重建 DOM、不发请求，无 JS 时表格仍然完整可用。
  // 排序 / 快捷筛选是上面的静态链接，不经过这里。
  const root = document.querySelector("[data-search-root]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-search-input]");
    const count = root.querySelector<HTMLElement>("[data-search-count]");
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("table.ptable tbody tr[data-search]"));
    const emptyState = document.getElementById("search-empty");
    const resetBtn = document.getElementById("reset-filters-btn");

    const state: Record<"category" | "language", string> = { category: "all", language: "all" };
    const chipsOf = (attr: string) => Array.from(root.querySelectorAll<HTMLButtonElement>(`[data-filter-${attr}]`));

    function apply() {
      const text = input?.value.trim().toLowerCase() ?? "";
      let visible = 0;
      for (const row of rows) {
        const show =
          (!text || (row.dataset.search ?? "").includes(text)) &&
          (state.category === "all" || row.dataset.category === state.category) &&
          (state.language === "all" || row.dataset.language === state.language);
        row.hidden = !show;
        if (show) visible++;
      }
      if (count) count.textContent = `${visible} / ${rows.length}`;
      if (emptyState) emptyState.classList.toggle("hidden", visible !== 0);
    }

    input?.addEventListener("input", apply);

    resetBtn?.addEventListener("click", () => {
      if (input) input.value = "";
      state.category = "all";
      state.language = "all";
      chipsOf("category").forEach((c) => c.classList.toggle("active", c.dataset.filterCategory === "all"));
      chipsOf("language").forEach((c) => c.classList.toggle("active", c.dataset.filterLanguage === "all"));
      apply();
    });

    for (const attr of ["category", "language"] as const) {
      const key = attr === "category" ? "filterCategory" : "filterLanguage";
      for (const chip of chipsOf(attr)) {
        chip.addEventListener("click", () => {
          chipsOf(attr).forEach((c) => c.classList.remove("active"));
          chip.classList.add("active");
          state[attr] = (chip.dataset as Record<string, string | undefined>)[key] ?? "all";
          apply();
        });
      }
    }

    apply();
  }
</script>

<style>
  .hidden { display: none !important; }
  .search-empty {
    text-align: center;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 36px 20px;
    margin: 20px 0 40px;
  }
  .empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 12px;
  }
  .search-empty h3 { margin: 0 0 6px; font-size: 16px; color: var(--ink); }
  .empty-tip { color: var(--muted); font-size: 13px; margin: 0 0 16px; }
  .reset-btn { font-size: 12.5px; padding: 6px 14px; }
  .filters { display: grid; gap: 12px; margin: 22px 0 6px; }
  .search-input {
    width: 100%;
    padding: 11px 15px;
    font-size: 14px;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
  }
  .search-input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .ctl-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .ctl-label { font-size: 12px; color: var(--muted); min-width: 52px; }
  .chips-row { display: flex; gap: 7px; flex-wrap: wrap; }
  .fchip {
    font-size: 12.5px;
    padding: 4px 13px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }
  .fchip:hover { border-color: var(--accent); color: var(--accent); }
  .fchip.active { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 600; }
  .preset-note { margin: -4px 0 0; font-size: 12px; color: var(--muted); }
  .count { margin: 0; font-size: 12px; color: var(--muted); }
</style>
