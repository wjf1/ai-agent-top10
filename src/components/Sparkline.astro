---
import { starSeries } from "../lib/periods";

interface Props {
  fullName: string;
  delta?: number;
  windowDays?: number;
  width?: number;
  height?: number;
}

const { fullName, delta = 0, windowDays = 21, width = 120, height = 36 } = Astro.props;

const points = starSeries(fullName, { limit: windowDays });
const values = points
  .map((p) => p.stars)
  .filter((v): v is number => typeof v === "number" && Number.isFinite(v));

const W = width;
const H = height;
const pad = 4;

let pathD = "";
let areaD = "";
let endPoint: { cx: number; cy: number } | null = null;

if (values.length >= 2) {
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;

  const coords = values.map((val, idx) => {
    const x = pad + (idx / (values.length - 1)) * (W - pad * 2);
    const y = H - pad - ((val - min) / range) * (H - pad * 2);
    return { x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10 };
  });

  pathD = coords.reduce((acc, pt, idx) => `${acc} ${idx === 0 ? "M" : "L"} ${pt.x} ${pt.y}`, "");
  const last = coords[coords.length - 1];
  const first = coords[0];
  areaD = `${pathD} L ${last.x} ${H} L ${first.x} ${H} Z`;
  endPoint = { cx: last.x, cy: last.y };
} else if (values.length === 1) {
  const y = H / 2;
  pathD = `M ${pad} ${y} L ${W - pad} ${y}`;
  areaD = `M ${pad} ${y} L ${W - pad} ${y} L ${W - pad} ${H} L ${pad} ${H} Z`;
  endPoint = { cx: W - pad, cy: y };
}

const fmt = (n: number) => Number(n ?? 0).toLocaleString("en-US");
const label = `近 ${values.length} 天 Star 趋势：+${fmt(delta)}`;
const id = `spark-grad-${fullName.replace(/[^a-zA-Z0-9]/g, "-")}`;
---

<div class="sparkline-wrap" title={label}>
  <svg
    class="sparkline"
    width={W}
    height={H}
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={label}
    focusable="false"
  >
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--data-primary, #6366f1)" stop-opacity="0.25"></stop>
        <stop offset="100%" stop-color="var(--data-primary, #6366f1)" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    {areaD && <path d={areaD} fill={`url(#${id})`} />}
    {pathD && (
      <path
        d={pathD}
        fill="none"
        stroke="var(--data-primary, #6366f1)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )}
    {endPoint && (
      <circle
        cx={endPoint.cx}
        cy={endPoint.cy}
        r="3"
        fill="var(--data-primary, #6366f1)"
      />
    )}
  </svg>
</div>

<style>
  .sparkline-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sparkline {
    display: block;
    overflow: visible;
  }
</style>
