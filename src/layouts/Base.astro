---
import "../styles/global.css";
import { strings, type Lang } from "../lib/data.ts";
import { archivePath, comparePath, dayPath, exportPath, homePath, monthPath, rssPath, searchPath, weekPath } from "../lib/routes.ts";

interface Props {
  lang?: Lang;
  title?: string;
  desc?: string;
  langHref?: string;
  /** 当前激活的导航项，用于高亮 */
  active?: "home" | "day" | "week" | "month" | "archive" | "search" | "compare" | "export";
  date?: string | null;
}

const { lang = "zh", title, desc, langHref, active, date = null } = Astro.props;
const t = strings(lang);
const B = import.meta.env.BASE_URL.replace(/\/$/, "");
const fullTitle = title ? `${title} · ${t.siteName}` : `${t.siteName} — ${t.tagline}`;
// 首页始终指向最新一期；若当前在某一期日报里，则“日榜”指向该期
const dailyHref = date && active === "day" ? dayPath(B, lang, date) : homePath(B, lang);

const nav = [
  { key: "home", href: dailyHref, label: t.periodDaily },
  { key: "week", href: weekPath(B, lang), label: t.periodWeekly },
  { key: "month", href: monthPath(B, lang), label: t.periodMonthly },
  { key: "archive", href: archivePath(B, lang), label: t.archive },
  { key: "search", href: searchPath(B, lang), label: t.searchPage },
  { key: "compare", href: comparePath(B, lang), label: t.compare },
  { key: "export", href: exportPath(B, lang), label: t.exportData },
];
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {desc && <meta name="description" content={desc} />}
    <link rel="alternate" type="application/rss+xml" title={`${t.siteName} RSS`} href={rssPath(B, lang)} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // 提前应用主题，避免暗色模式下的白屏闪烁
      (function () {
        try {
          var saved = localStorage.getItem("agent-top10-theme");
          var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "zh" ? "跳到主要内容" : "Skip to content"}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={homePath(B, lang)}>
          <span class="bolt" aria-hidden="true">⚡</span>
          <span class="logo-text">{t.siteName}<small>{t.tagline}</small></span>
        </a>
        <nav aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
          {nav.map((item) => (
            <a href={item.href} class:list={[item.key === active && "active"]}>{item.label}</a>
          ))}
          <a class="lang-switch" href={langHref ?? homePath(B, lang === "en" ? "zh" : "en")}>
            {lang === "zh" ? "English" : "中文"}
          </a>
          <button class="theme-toggle" type="button" data-theme-toggle title={t.darkMode} aria-label={t.darkMode}>
            <span class="icon-light" aria-hidden="true">☀</span>
            <span class="icon-dark" aria-hidden="true">☾</span>
          </button>
        </nav>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>{t.footerNote}</span>
        <span class="foot-right">
          <a href={rssPath(B, lang)}>RSS</a>
          <span>{t.siteName} · {new Date().getFullYear()}</span>
        </span>
      </div>
    </footer>
  </body>
</html>

<script>
  const btn = document.querySelector("[data-theme-toggle]");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("agent-top10-theme", next);
    } catch {
      /* 隐私模式下 localStorage 不可用，忽略即可 */
    }
  });
</script>
