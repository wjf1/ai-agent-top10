---
/** 指定日期的日榜（P0-C2 修复：归档页每一行都落到这里自己的日期） */
import RankingPage from "../../../components/RankingPage.astro";
import { index, loadDay, neighbours } from "../../../lib/load-days";
import { archivePath, dayPath, homePath } from "../../../lib/routes.ts";

export function getStaticPaths() {
  const langs = [
    { lang: undefined as string | undefined, prefix: "zh" as const },
    { lang: "en", prefix: "en" as const },
  ];
  return langs.flatMap(({ lang }) =>
    index.dates.map((date) => ({ params: { lang, date }, props: { date, langKind: lang ? "en" : "zh" } }))
  );
}

const { date, langKind } = Astro.props as { date: string; langKind: "zh" | "en" };
const lang = langKind;
const B = import.meta.env.BASE_URL.replace(/\/$/, "");
const day = await loadDay(date);
const nav = neighbours(date);
---

<RankingPage
  {lang}
  period="daily"
  {date}
  entries={day?.entries ?? []}
  poolSize={day?.poolSize}
  archiveHref={archivePath(B, lang)}
  langHref={dayPath(B, lang === "en" ? "zh" : "en", date)}
  prevHref={nav.prev ? dayPath(B, lang, nav.prev) : null}
  nextHref={nav.next ? dayPath(B, lang, nav.next) : homePath(B, lang)}
/>
