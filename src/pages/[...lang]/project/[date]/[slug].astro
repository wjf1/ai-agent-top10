---
/**
 * 项目详情页 —— 路由带日期（P0-C1 修复）。
 *
 * 旧路由 /project/<slug>/ 下，同一个项目在不同日期生成同一个路径，
 * 后建的页面静默覆盖先建的，除最后一天外全部丢失（50 个条目只剩 16 个页面）。
 * 现在每个项目每天一个独立路径：/project/<date>/<slug>/。
 */
import ProjectDetail from "../../../../components/ProjectDetail.astro";
import { pickRelated, relatedPoolCached } from "../../../../lib/aggregate";
import { index, loadDay, appearances } from "../../../../lib/load-days";
import { streakLength } from "../../../../lib/display.ts";
import { meetsScoreTrendGate, scoreSeriesForDims } from "../../../../lib/score-series";
import { dimensionLabels } from "../../../../lib/data.ts";
import { starSeries } from "../../../../lib/periods";
import { projectPath } from "../../../../lib/routes.ts";

export async function getStaticPaths() {
  const langVariants = [
    { lang: undefined as string | undefined, kind: "zh" as const },
    { lang: "en", kind: "en" as const },
  ];
  const out: any[] = [];
  for (const day of index.days) {
    for (const slug of day.slugs ?? []) {
      for (const variant of langVariants) {
        out.push({
          params: { lang: variant.lang, date: day.date, slug },
          props: { date: day.date, slug, kind: variant.kind },
        });
      }
    }
  }
  return out;
}

const { date, slug, kind } = Astro.props as { date: string; slug: string; kind: "zh" | "en" };
const lang = kind;
const B = import.meta.env.BASE_URL.replace(/\/$/, "");

const day = await loadDay(date);
const entry = day?.entries.find((e) => e.slug === slug);
if (!entry) throw new Error(`entry ${slug} not found in ${date}`);
const series = starSeries(entry.full_name);
const seenDates = appearances(entry.slug);
const streak = streakLength(index.dates, seenDates, date);
// 条目里存的 firstSeen 是"本次抓取日"，连续多期上榜的项目会被写成最新那天，
// 所以首次上榜必须以索引里最早出现该 slug 的日期为准。
const firstDate = seenDates[0] ?? entry.firstSeen ?? date;
const related = pickRelated(entry, date, await relatedPoolCached(), { similar: 3, hot: 2 });
// 只为最新一期生成 OG 图（见 scripts/generate-og.mjs），历史期回落到首页分享图
const isLatest = index.dates[0] === date;
const ogImage = isLatest ? `${B}/og/${lang}-${entry.slug}.png` : undefined;

// T3.2 评分趋势：只在连续在榜 >= 3 期时聚合，避免 2 个点画出的伪趋势。
// 只对实际在榜的日期取分，缺失维度不补零（早期数据没有 forksGrowth / activity）。
const trendDims = dimensionLabels(lang).map((d) => ({ key: d.key, label: d.short ?? d.key }));
const scoreTrend = meetsScoreTrendGate(streak)
  ? await scoreSeriesForDims(entry.slug, trendDims.map((d) => d.key))
  : null;
---

<ProjectDetail
  {entry}
  {date}
  {lang}
  {series}
  {streak}
  {firstDate}
  {related}
  {ogImage}
  trendDims={trendDims}
  {scoreTrend}
  windowDays={day.windowDays ?? 7}
  langHref={projectPath(B, lang === "en" ? "zh" : "en", date, slug)}
/>
