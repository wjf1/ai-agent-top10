---
/**
 * 项目检索（P2-F3 / T3.1）。
 *
 * 排序与快捷筛选是独立静态路由（见 search/[...view].astro），因此本页只负责
 * 默认视图（按累计增量）。共享 UI 在 components/SearchView.astro。
 * 渐进增强：完整表格在构建期就渲染好（无 JS 也能用、SEO 友好）。
 */
import Base from "../../layouts/Base.astro";
import SearchView from "../../components/SearchView.astro";
import { recentProjects } from "../../lib/aggregate";
import { strings } from "../../lib/data.ts";
import { searchPath } from "../../lib/routes.ts";

const WINDOW = 30;

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }];
}

const lang = (Astro.params.lang === "en" ? "en" : "zh") as "zh" | "en";
const t = strings(lang);
const B = import.meta.env.BASE_URL.replace(/\/$/, "");
const projects = await recentProjects({ window: WINDOW });
---

<Base
  {lang}
  langHref={searchPath(B, lang === "en" ? "zh" : "en")}
  title={t.searchPage}
  desc={t.search}
  active="search"
>
  <section class="hero" style="padding-bottom:0">
    <h1>{t.searchPage}</h1>
    <p class="sub">{t.searchScope(WINDOW)}</p>
  </section>

  <SearchView {projects} {lang} window={WINDOW} />
</Base>
