---
import ProjectDetail from "../../components/ProjectDetail.astro";
import { days } from "../../lib/load-days.ts";

export function getStaticPaths() {
  return days.flatMap((day) =>
    day.entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry, date: day.date } }))
  );
}
const { entry, date } = Astro.props;
---
<ProjectDetail entry={entry} date={date} lang="zh" />
